{
  "name": "olea-connects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e --project=chromium --grep @smoke",
    "test:e2e:pr": "playwright test tests/e2e --project=chromium --grep @smoke",
    "test:e2e:critical": "playwright test tests/e2e --project=chromium --grep @critical",
    "test:e2e:a11y": "playwright test tests/accessibility --project=chromium",
    "test:e2e:data": "PLAYWRIGHT_SKIP_WEBSERVER=true playwright test tests/integration/test-data-isolation.spec.ts --project=chromium",
    "test:e2e:data:local": "bash scripts/with-local-supabase.sh npm run test:e2e:data",
    "test:db": "HOME=\"$PWD/.supabase-home\" supabase test db supabase/tests --local",
    "test:db:local": "bash scripts/with-local-supabase.sh npm run test:db",
    "test:e2e:authenticated": "playwright test tests/e2e/authenticated-member.spec.ts --project=chromium",
    "test:e2e:authenticated:local": "bash scripts/with-local-supabase.sh npm run test:e2e:authenticated",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@react-pdf/renderer": "^4.1.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "supabase": "^2.106.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
