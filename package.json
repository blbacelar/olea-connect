{
  "name": "olea-connects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e --project=chromium --grep @smoke",
    "test:e2e:pr": "playwright test tests/e2e --project=chromium --grep @smoke",
    "test:e2e:webinars": "playwright test tests/e2e/webinars-events.spec.ts --project=chromium",
    "test:e2e:webinars:local": "bash scripts/with-local-supabase.sh npm run test:e2e:webinars",
    "test:e2e:platform": "playwright test tests/e2e/platform-ui-coverage.spec.ts --project=chromium",
    "test:e2e:platform:local": "bash scripts/with-local-supabase.sh npm run test:e2e:platform",
    "test:e2e:community": "playwright test tests/e2e/native-community.spec.ts --project=chromium",
    "test:e2e:community:local": "bash scripts/with-local-supabase.sh npm run test:e2e:community",
    "test:e2e:consulting": "playwright test tests/e2e/consulting-workflow.spec.ts --project=chromium",
    "test:e2e:consulting:local": "bash scripts/with-local-supabase.sh npm run test:e2e:consulting",
    "test:e2e:security": "playwright test tests/e2e/security-boundaries.spec.ts --project=chromium",
    "test:e2e:security:local": "bash scripts/with-local-supabase.sh npm run test:e2e:security",
    "test:e2e:critical": "playwright test tests/e2e --project=chromium --grep @critical",
    "test:e2e:a11y": "playwright test tests/accessibility --project=chromium",
    "test:e2e:data": "PLAYWRIGHT_SKIP_WEBSERVER=true playwright test tests/integration/test-data-isolation.spec.ts --project=chromium",
    "test:e2e:data:local": "bash scripts/with-local-supabase.sh npm run test:e2e:data",
    "test:db": "HOME=\"$PWD/.supabase-home\" supabase test db supabase/tests --local",
    "test:db:local": "bash scripts/with-local-supabase.sh npm run test:db",
    "test:e2e:authenticated": "playwright test tests/e2e/authenticated-member.spec.ts --project=chromium",
    "test:e2e:authenticated:local": "bash scripts/with-local-supabase.sh npm run test:e2e:authenticated",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "security:audit": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "docx": "^9.14.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^14.2.35",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.4.49",
    "supabase": "^2.106.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "glob": "10.5.0"
  }
}
